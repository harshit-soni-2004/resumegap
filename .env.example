# =========================================================
# ResumeGap Environment Configuration
# =========================================================

# 1. Google Gemini API (Required for Stage 2 LLM analysis)
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=

# Model selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Admin Dashboard Security (Required for /admin route)
# If omitted, /admin route returns HTTP 503 Service Unavailable
ADMIN_SECRET_KEY=

# 3. Persistent Analytics & Feedback (Optional for local dev; recommended for Vercel)
# Supabase project URL & Service Role key (or Anon key)
# Tables needed: analytics_events(id, session_id, event_name, timestamp, data), feedback(id, session_id, helpful, comment, score, created_at)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Distributed Serverless Rate Limiting (Optional for local dev; recommended for Vercel)
# Upstash Redis REST credentials from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
